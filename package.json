{
	"name": "pi",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "node scripts/workspaces.mjs lint && biome lint --error-on-warnings scripts",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"typecheck": "node scripts/workspaces.mjs typecheck",
		"test": "node --test scripts/test-conventions.test.mjs && node scripts/workspaces.mjs test",
		"check": "npm run lint && npm run format:check && npm run typecheck && npm test"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.5.0",
		"typescript": "7.0.2",
		"vitest": "5.0.5",
		"yaml": "2.9.1",
		"@biomejs/biome": "2.3.5"
	},
	"packageManager": "npm@11.19.1",
	"workspaces": [
		"packages/*"
	],
	"engines": {
		"node": ">=22.19.0",
		"npm": ">=11"
	},
	"pi": {
		"extensions": [
			"./packages/output-styles/src/index.ts",
			"./packages/footer/src/index.ts"
		]
	}
}
